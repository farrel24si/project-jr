DB_HOST=localhost
DB_USER=root
DB_PASSWORD=PASSWORD
DB_NAME=db_monitoring_jr
PORT=5000

# Rahasia JWT & masa berlaku (default 8h)
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=8h

# Notifikasi WhatsApp Petugas (default false agar aman saat testing/dev)
ENABLE_WHATSAPP_NOTIFICATIONS=false
